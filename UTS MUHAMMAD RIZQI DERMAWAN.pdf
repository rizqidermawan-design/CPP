BT 1 0 0 1 8 592 Tm /F3 8 Tf 10 TL (#include <iostream>) Tj T* (#include <string>) Tj T* (#include <limits>) Tj T* (using namespace std;) Tj T*  T* (int main\(\) {) Tj T* (    int jumlah, nilai;) Tj T* (    int total = 0, lulus = 0, tidakLulus = 0;) Tj T* (    int nilaiTertinggi = -1, nilaiTerendah = 101;) Tj T* (    double rataRata;) Tj T* (    string nama, namaTertinggi, namaTerendah;) Tj T*  T* (    cout << "Jumlah mahasiswa : ";) Tj T* (    cin >> jumlah;) Tj T*  T* (    if \(jumlah <= 0\) {) Tj T* (        cout << "Jumlah mahasiswa harus lebih dari 0." << endl;) Tj T* (        return 0;) Tj T* (    }) Tj T*  T* (    for \(int i = 1; i <= jumlah; i++\) {) Tj T* (        cout << "\\\\nNama Mahasiswa ke-" << i << " : ";) Tj T* (        getline\(cin >> ws, nama\);) Tj T*  T* (        cout << "Nilai mahasiswa ke-" << i << " : ";) Tj T* (        cin >> nilai;) Tj T*  T* (        total += nilai;) Tj T*  T* (        if \(nilai >= 60\) {) Tj T* (            lulus++;) Tj T* (        } else {) Tj T* (            tidakLulus++;) Tj T* (        }) Tj T*  T* (        if \(nilai > nilaiTertinggi\) {) Tj T* (            nilaiTertinggi = nilai;) Tj T* (            namaTertinggi = nama;) Tj T* (        }) Tj T*  T* (        if \(nilai < nilaiTerendah\) {) Tj T* (            nilaiTerendah = nilai;) Tj T* (            namaTerendah = nama;) Tj T* (        }) Tj T* (    }) Tj T*  T* (    rataRata = static_cast<double>\(total\) / jumlah;) Tj T*  T* (    cout << "\\\\n===== HASIL PENGOLAHAN NILAI =====" << endl;) Tj T* (    cout << "Total nilai                 : " << total << endl;) Tj T* (    cout << "Rata-rata                   : " << rataRata << endl;) Tj T* (    cout << "Jumlah lulus                : " << lulus << endl;) Tj T* (    cout << "Jumlah tidak lulus          : " << tidakLulus << endl;) Tj T* (    cout << "Mahasiswa nilai tertinggi   : " << namaTertinggi) Tj T* (         << " \(" << nilaiTertinggi << "\)" << endl;) Tj T* (    cout << "Mahasiswa nilai terendah    : " << namaTerendah) Tj T* (         << " \(" << nilaiTerendah << "\)" << endl;) Tj T*  T* (    return 0;) Tj T* (}) Tj T* ET
